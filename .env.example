# Path A: Liquidation Independent Alpha
# Phase 2 API Credentials

# CryptoQuant API Key (liquidation ground truth)
# Sign up: https://www.cryptoquant.com
# Required for: liquidation events, cascade detection
CRYPTOQUANT_API_KEY=your_cryptoquant_key_here

# Glassnode API Key (exchange flows)
# Sign up: https://glassnode.com
# Required for: CEX inflows/outflows, whale accumulation
GLASSNODE_API_KEY=your_glassnode_key_here

# Optional: Data paths
PHASE2_DATA_DIR=data/processed/phase2
PHASE2_CACHE_DIR=.cache/phase2

# Optional: API rate limits (requests per minute)
CRYPTOQUANT_RPM=60
GLASSNODE_RPM=60

# Phase 2 collection window (days)
PHASE2_LOOKBACK_DAYS=180

# Logging
LOG_LEVEL=INFO
