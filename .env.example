# IGWT-PF26 Environment Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Keys (Public sources only — NO CEX trading keys)
COINGECKO_API_KEY=
BINANCE_API_KEY=  # Optional: public API key only (no secret)
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NANSEN_API_KEY=
ARKHAM_API_KEY=

# Data Configuration
DATA_POLL_INTERVAL=3600  # Seconds between data collection runs
LOOKBACK_DAYS=365

# Validation Thresholds
BCE_THRESHOLD=5.0
X20_THRESHOLD=70.0
NARM_THRESHOLD=60.0
RCM_THRESHOLD=70.0
RRP_THRESHOLD=60.0

# Database
DUCKDB_PATH=./data/processed/igwt.duckdb
FEATURE_STORE_PATH=./data/processed/features.parquet

# Backtest Settings
MIN_TRADES_BACKTEST=200
MIN_PROFIT_FACTOR=1.3
MAX_DRAWDOWN_PCT=25.0
WALK_FORWARD_PERIODS=5

# Web API (if using FastAPI server)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Testing
PYTEST_CURRENT_TEST=  # Set automatically by pytest
USE_MOCK_DATA=true   # For development/testing without real API calls
