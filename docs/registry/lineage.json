{
  "schema_version": 1,
  "amendment_rules": {
    "new_source_never_amends": "A new data source never retroactively modifies an existing research artefact. When the methodological scope changes, it creates a new reference.",
    "no_inferred_ancestry": "A relation is never inferred from a name, a numbering scheme or temporal proximity. Every relation carries evidence resolvable inside this repository."
  },
  "relation_types": {
    "contract_dependency": "this artefact must satisfy the target contract",
    "parent": "this artefact descends from the target: same feature code and parameters",
    "control": "this artefact uses the target as an independent reference fixture for comparison or validation",
    "derived": "this artefact was extracted from the target",
    "result_of": "this artefact is a research result computed on the target dataset",
    "sibling": "this artefact and the target share an ancestor and neither depends on the other"
  },
  "artefact_kinds": ["contract", "dataset", "result", "code"],
  "statuses": {
    "FROZEN": "contract; any change is a new version",
    "LOCKED": "artefact pinned by hash; never edited retroactively",
    "PENDING_ACQUISITION": "pipeline implemented, data not available",
    "RECORDED": "research result recorded with its scope",
    "ACTIVE": "code in use"
  },
  "allowed_targets": {
    "contract_dependency": ["contract"],
    "parent": ["dataset"],
    "control": ["dataset"],
    "derived": ["dataset", "code"],
    "result_of": ["dataset"],
    "sibling": ["contract", "dataset", "result", "code"]
  },
